{
    "name": "prop-show",
    "type": "module",
    "private": true,
    "packageManager": "pnpm@12.15.0",
    "engines": {
        "node": ">=24.21.0"
    },
    "scripts": {
        "build": "pnpm generate:og && vite build",
        "generate:og": "node scripts/generate-og.ts",
        "dev": "vite",
        "dev:seo": "pnpm generate:og && vite",
        "fetch:videos": "node scripts/fetch-videos.ts",
        "preview": "vite preview",
        "postinstall": "simple-git-hooks",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "deploy": "void deploy --platform cloudflare",
        "deploy:preview": "wrangler preview --config dist/ssr/wrangler.json",
        "test": "vitest run --project unit",
        "test:watch": "vitest --project unit",
        "check:seo": "vitest run --project e2e",
        "typecheck": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@cloudflare/vite-plugin": "^1.65.0",
        "@comark/html": "^0.7.0",
        "@iconify-json/lucide": "^1.2.147",
        "@iconify-json/tabler": "^1.2.42",
        "@tabler/icons-vue": "^3.49.0",
        "@void/vue": "1.3.0",
        "@vueuse/core": "^15.0.0",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.0",
        "comark": "^0.8.1",
        "hono": "^4.13.14",
        "reka-ui": "^2.11.0",
        "shiki": "^4.5.0",
        "vue": "^3.5.44",
        "yaml": "^2.9.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^9.5.1",
        "@fontsource-variable/noto-sans-sc": "5.3.1",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@takumi-rs/core": "2.16.3",
        "@types/node": "^24.19.2",
        "eslint": "^10.13.0",
        "nano-staged": "^1.0.2",
        "simple-git-hooks": "^2.14.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "undici": "^8.12.3",
        "unplugin-auto-import": "^21.1.0",
        "unplugin-icons": "^24.0.0",
        "unplugin-vue-components": "^32.1.0",
        "vite": "^8.3.5",
        "vitest": "^5.0.5",
        "void": "1.3.0",
        "vue-tsc": "^3.3.13",
        "wrangler": "^4.154.0"
    },
    "simple-git-hooks": {
        "pre-commit": "./node_modules/.bin/nano-staged"
    },
    "nano-staged": {
        "*": "eslint --fix"
    }
}
