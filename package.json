{
    "name": "prop-show",
    "type": "module",
    "private": true,
    "packageManager": "pnpm@12.11.2",
    "engines": {
        "node": ">=24.21.0"
    },
    "scripts": {
        "build": "node scripts/generate-icons.mjs && vite build",
        "dev": "vite --port 4399",
        "fetch:videos": "node scripts/fetch-videos.ts",
        "preview": "vite preview --port 4399",
        "postinstall": "simple-git-hooks",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "deploy": "void deploy",
        "deploy:preview": "wrangler preview --config dist/ssr/wrangler.json",
        "test": "vitest run --project unit",
        "test:watch": "vitest --project unit",
        "check:seo": "vitest run --project e2e",
        "typecheck": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@comark/html": "^0.7.0",
        "@iconify-json/lucide": "^1.2.145",
        "@iconify-json/tabler": "^1.2.42",
        "@iconify/vue": "^5.0.3",
        "@nuxt/ui": "^4.11.3",
        "@void/vue": "1.1.11",
        "comark": "^0.7.0",
        "hono": "^4.13.13",
        "shiki": "^4.5.0",
        "vue": "^3.5.43",
        "yaml": "^2.8.0"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^9.5.1",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^24.0.0",
        "eslint": "^10.12.0",
        "nano-staged": "^1.0.2",
        "simple-git-hooks": "^2.14.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "undici": "^8.12.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.5",
        "void": "1.1.11",
        "vue-tsc": "^3.3.7",
        "wrangler": "4.151.1"
    },
    "simple-git-hooks": {
        "pre-commit": "./node_modules/.bin/nano-staged"
    },
    "nano-staged": {
        "*": "eslint --fix"
    }
}
