        "@nuxtjs/seo": "5.3.2",
        "better-sqlite3": "^12.11.1",
        "nuxt": "^4.5.2",
        "vue": "^3.5.41",
        "vue-router": "^5.2.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^9.3.0",
        "@nuxt/eslint": "1.16.0",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "eslint": "^10.9.0",
        "eslint-plugin-format": "^2.0.1",
        "nano-staged": "^1.0.2",
        "simple-git-hooks": "^2.13.1",
        "tailwindcss": "^4.3.3",
