{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "paths": { "@/*": ["./src/*"] },
        "resolveJsonModule": true,
        "types": ["vite/client", "node"],
        "allowImportingTsExtensions": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.vue", "src/**/*.ts", "tests/**/*.ts", "scripts/generate-content.ts", "scripts/generate-og.ts", "scripts/content-plugin.ts", "vite.config.ts", "vitest.config.ts", "void.config.ts"]
}
